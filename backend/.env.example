# PostgreSQL connection. Use a local development database; never commit .env.
DATABASE_URL=postgresql+psycopg://stockit_user:change_me@localhost:5432/stockit

# Required for issuing and verifying JWTs. Generate a long, random value.
APP_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Virtual funds granted when a user registers.
INITIAL_VIRTUAL_CASH=100000.00

# Market data remains server-side only.
JWT_SECRET=replace-with-a-secure-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_ENV=development

MARKET_DATA_API_KEY=your_twelve_data_api_key
MARKET_DATA_BASE_URL=https://api.twelvedata.com
MARKET_CACHE_SECONDS=45
MARKET_HISTORY_CACHE_SECONDS=3600
